# ---- Runtime env for Docker ----
NODE_ENV=production
PORT=4000
APP_NAME=booking-api
TZ=Asia/Manila

# IMPORTANT: if your password contains @ or other special chars, URL-encode them.
# Example: Liame@2024 -> Liame%402024
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/booking_app?schema=public

# JWT
JWT_ACCESS_SECRET=superlongrandomaccesssecret
JWT_ACCESS_TTL=900s
REFRESH_TTL_DAYS=30

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# OAuth (adjust as needed)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Mail (Gmail SMTP example)
MAIL_FROM="Booking Demo <spiderman14317@gmail.com>"
MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="spiderman14317@gmail.com"
SMTP_PASS="vmktdsoajbhkicyh"

APP_SHOW_ERROR_STACK=true

# Sentry
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_RELEASE=local-docker

# Redis (use the service name 'redis')
REDIS_URL=redis://:${REDIS_PASSWORD:-devpass}@redis:6379/0

# Admin Key
ADMIN_API_KEY=sampleadminkey12345
